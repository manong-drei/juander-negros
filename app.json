{
  "expo": {
    "name": "Juander Negros",
    "slug": "juander-negros",
    "version": "1.0.0",
    "scheme": "juandernegros",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A5C38"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.juandernegros.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Juander Negros uses your location to show nearby destinations.",
        "NSLocationAlwaysUsageDescription": "Juander Negros uses your location to show nearby destinations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A5C38"
      },
      "package": "com.juandernegros.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A5C38"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "23e90280-9d20-4aef-8912-b677809b48ec"
      }
    }
  }
}
